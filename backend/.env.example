# Ejemplos: completa backend/.env con tus datos locales. No publiques ese archivo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=CAMBIAR_BASE_DE_DATOS
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_PASSWORD
DB_CONNECT_TIMEOUT=5
JWT_SECRET=CAMBIAR_por_una_clave_aleatoria_de_32_caracteres
JWT_EXPIRATION_HOURS=8

# Correo de avisos de vencimiento (opcional en desarrollo).
# Sin estas variables el job de avisos informa que falta configurar el correo.
# Gmail exige una contrasena de aplicacion, no la contrasena de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# inicio = STARTTLS (587), ssl = SSL directo (465), ninguno = sin cifrado.
SMTP_TLS=inicio
SMTP_USUARIO=CAMBIAR_correo_de_envio
SMTP_PASSWORD=CAMBIAR_contrasena_de_aplicacion
SMTP_REMITENTE=CAMBIAR_correo_de_envio
SMTP_NOMBRE=Parkeo
